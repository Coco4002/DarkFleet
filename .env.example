# Copy to .env and fill in. .env is git-ignored; never commit real values.

# aisstream.io API key (GitHub login on aisstream.io)
AISSTREAM_API_KEY=

# Database
POSTGRES_PASSWORD=

# Admin API key (X-Api-Key header) for admin endpoints until the web login exists. Generate with:
#   openssl rand -hex 32
DARKFLEET_ADMIN_API_KEY=

# Key other DarkFleet services use to call each other (X-Api-Key header). Generate with:
#   openssl rand -hex 32
DARKFLEET_INTERNAL_API_KEY=

# Read-only key map-gateway uses to fetch track history and coverage from Vessel Intelligence:
#   openssl rand -hex 32
DARKFLEET_GATEWAY_API_KEY=

# Live feeds shown on the public map (comma-separated: DIGITRAFFIC,AISSTREAM).
# Set to DIGITRAFFIC if aisstream.io redistribution terms are not confirmed before going public.
DARKFLEET_PUBLIC_SOURCES=DIGITRAFFIC,AISSTREAM

# Web login for people (browser). A blank password means that account does not exist.
# Analysts see detections, cases and proposals and approve them; the admin also approves rule changes.
DARKFLEET_ANALYST_USER=analyst
DARKFLEET_ANALYST_PASSWORD=
DARKFLEET_ADMIN_USER=admin
DARKFLEET_ADMIN_PASSWORD=

# Server only: the public domain name (enables HTTPS). Leave unset locally.
# DARKFLEET_SITE_ADDRESS=darkfleet.example.org

# Server only: pull CI-built images instead of building locally.
# DARKFLEET_IMAGE_PREFIX=ghcr.io/<github-owner>/darkfleet-
# DARKFLEET_TAG=main
